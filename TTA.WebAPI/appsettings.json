{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.File",
            "Serilog.Exceptions"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Error"
            }
        },
        "Enrich": [ "FromLogContext", "WithExceptionDetails" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-prod-.json",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 2
                }
            }
        ]
    },
    "AllowedHosts": "*"
}