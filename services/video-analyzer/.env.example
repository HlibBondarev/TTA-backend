# Internal service-to-service authentication shared with TTA.WebAPI
# Required before starting the API server; must be a unique non-placeholder secret.
INTERNAL_API_KEY=
# SERVICE_HOST=127.0.0.1
# CALLBACK_ALLOWED_ORIGINS=["http://127.0.0.1:5000"]
# CALLBACK_API_KEY=

# Google Gemini API configuration (Pass 1 VLM and Pass 2 cap crop-grid reader)
GEMINI_API_KEY=
GEMINI_PASS1_MODEL=gemini-2.5-flash
GEMINI_PASS2_MODEL=gemini-2.5-flash

# ==============================================================================
# Pluggable Object Detector Configuration (Zero-code provider/model switching)
# ==============================================================================
# Default: Hosted/Self-hosted Roboflow Water Polo model
DETECTOR_PROVIDER=roboflow
DETECTOR_MODEL_PATH_OR_ID=waterpolo-salvasc/5
DETECTOR_CONFIDENCE=0.25
DETECTOR_IOU=0.45
DETECTOR_DEVICE=auto
DETECTOR_CLASS_MAP={"White team":"player","Blue team":"player","Goalkeeper":"player","ball":"ball","Goal":"goal","Referee":"referee"}
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com

# Example 1: Switch to local Ultralytics YOLO weights without any code changes:
# DETECTOR_PROVIDER=local_yolo
# DETECTOR_MODEL_PATH_OR_ID=yolo11m.pt
# DETECTOR_CLASS_MAP={"person":"player","sports ball":"ball"}

# Example 2: Switch to local ONNX Runtime model without any code changes:
# DETECTOR_PROVIDER=onnx
# DETECTOR_MODEL_PATH_OR_ID=/models/waterpolo-yolo11m.onnx
# DETECTOR_CLASS_MAP={"0":"player","1":"ball","2":"goal"}

# Pass 2 Multi-Object Tracker & Cap Resolution
TRACKER_TYPE=botsort
CAP_RESOLVER_PROVIDER=gemini_crop_grid
# Optional local OCR fallback (requires `pip install -e ".[ocr]"`):
# CAP_RESOLVER_PROVIDER=local_ocr

# Media binaries (override on Windows if ffmpeg/ffprobe are not on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
