# Internal service-to-service authentication shared with TTA.WebAPI
# Required before starting the API server; must be a unique non-placeholder secret.
INTERNAL_API_KEY=
# SERVICE_HOST=127.0.0.1
# CALLBACK_ALLOWED_ORIGINS=["http://127.0.0.1:5000"]
# CALLBACK_API_KEY=

# Optional: TTA .NET API used by `analyze --match-id/--team-id` to fetch the analysis-snapshot.
# TTA_API_BASE_URL=http://127.0.0.1:5000
# TTA_API_TIMEOUT_SEC=30

# ==============================================================================
# Google Gemini API: three model slots (Paid Tier 1 defaults; Free Tier values in comments)
# ==============================================================================
GEMINI_API_KEY=
# Pass 1 global event/anchor detection
GEMINI_PASS1_MODEL=gemini-4-hydrogen
# Reserved for the Pass 1 verifier clip (#158); not called yet. May also be gemini-4-neon.
GEMINI_VERIFIER_MODEL=gemini-4-hydrogen
# Pass 2 cap-number crop-grid reader
GEMINI_PASS2_MODEL=gemini-3.5-flash-lite

# Per-slot thinking level: MINIMAL | LOW | MEDIUM | HIGH. Leave unset/empty to omit
# `thinking_config` from the request entirely (required for models that reject the field,
# e.g. gemini-3.5-flash-lite). thinking_budget is never sent; include_thoughts is never enabled.
GEMINI_PASS1_THINKING_LEVEL=LOW
# GEMINI_VERIFIER_THINKING_LEVEL=
# GEMINI_PASS2_THINKING_LEVEL=

# Per-model requests-per-minute pacing (Free Tier: 5 / 15)
# GEMINI_PASS1_RPM=60
# GEMINI_PASS2_RPM=120
# Jittered exponential backoff on 500/503/504, timeouts and short (<= 60s) per-minute 429s.
# 400/401/403, daily (PerDay) 429 and retryDelay > 60s are never retried and open the breaker.
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_BASE_SEC=2.0
# Per-job budget circuit breaker (Free Tier: 20 calls, 0.50 USD; empty = unlimited)
# GEMINI_MAX_CALLS_PER_JOB=120
# GEMINI_MAX_ESTIMATED_COST_USD=3.00
# Optional JSON object (or path to a JSON file) overriding/extending per-1M-token USD estimates:
# GEMINI_MODEL_PRICING_USD_PER_1M={"gemini-4-hydrogen":{"input":1.50,"output":7.50}}

# ==============================================================================
# Pipeline parallelism (Free Tier: 1 for every value below)
# ==============================================================================
# Bounded parallel Pass 1 chunk analysis; 1 reproduces sequential behavior.
# PASS1_MAX_CONCURRENCY=3
# Pass 2 Phase A (extract + detect + track + crop selection) and Phase B (Gemini cap resolution)
# PASS2_PHASE_A_MAX_CONCURRENCY=4
# PASS2_PHASE_B_MAX_CONCURRENCY=4
# Events per Phase A -> Phase B batch. Bounds how many crop bundles are held in memory at once
# (peak Pass 2 memory no longer grows with match length).
# PASS2_BATCH_SIZE=48
# ONE global cap on simultaneous remote detector calls across ALL Phase A tasks.
# Local ONNX/YOLO providers always run serially regardless of this value.
# DETECTOR_MAX_CONCURRENCY=4
# Frames are downscaled to this width for detection; boxes are rescaled to native pixels.
# DETECTOR_INPUT_WIDTH=1280

# ==============================================================================
# Pluggable Object Detector Configuration (Zero-code provider/model switching)
# ==============================================================================
# Default: Hosted/Self-hosted Roboflow Water Polo model
DETECTOR_PROVIDER=roboflow
DETECTOR_MODEL_PATH_OR_ID=waterpolo-salvasc/5
DETECTOR_CONFIDENCE=0.25
DETECTOR_IOU=0.45
DETECTOR_DEVICE=auto
DETECTOR_CLASS_MAP={"White team":"player","Blue team":"player","Goalkeeper":"player","ball":"ball","Goal":"goal","Referee":"referee"}
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com
# Retry/backoff for transient Roboflow failures (timeouts, 429, 5xx)
# ROBOFLOW_MAX_RETRIES=3
# ROBOFLOW_RETRY_BASE_SEC=1.0

# Example 1: Switch to local Ultralytics YOLO weights without any code changes:
# DETECTOR_PROVIDER=local_yolo
# DETECTOR_MODEL_PATH_OR_ID=yolo11m.pt
# DETECTOR_CLASS_MAP={"person":"player","sports ball":"ball"}

# Example 2: Switch to local ONNX Runtime model without any code changes:
# DETECTOR_PROVIDER=onnx
# DETECTOR_MODEL_PATH_OR_ID=/models/waterpolo-yolo11m.onnx
# DETECTOR_ONNX_OUTPUT_LAYOUT=auto
# DETECTOR_CLASS_MAP={"0":"player","1":"ball","2":"goal"}

# Pass 2 Multi-Object Tracker & Cap Resolution
TRACKER_TYPE=botsort
CAP_RESOLVER_PROVIDER=gemini_crop_grid
# Optional local OCR fallback (requires `pip install -e ".[ocr]"`):
# CAP_RESOLVER_PROVIDER=local_ocr
# When easyocr is installed, local OCR is also used automatically for the remaining events
# if the Gemini Pass 2 circuit breaker opens.

# Media binaries (override on Windows if ffmpeg/ffprobe are not on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Pass 1 mezzanine hardware decode: "auto" lets ffmpeg choose a backend, "none" disables it
# (use "none" in CI).
# FFMPEG_HWACCEL=auto
# Mezzanine encoder: "auto" probes `ffmpeg -encoders` and tries h264_nvenc, h264_qsv, h264_amf,
# libx264 in that order, moving to the next one whenever an encoder fails at runtime (a listed
# encoder may have no matching GPU); or name an encoder explicitly (libx264 is always the last
# resort).
# FFMPEG_VIDEO_ENCODER=auto
# Pass 2 4K window decoders. Each HEVC 4K decoder can hold ~1-1.7 GB, so total RAM is roughly
# FFMPEG_EXTRACTION_MAX_CONCURRENCY x per-decoder RAM, independent of the (higher)
# PASS2_PHASE_A_MAX_CONCURRENCY that overlaps remote detector network calls.
# FFMPEG_EXTRACTION_MAX_CONCURRENCY=2
# `-threads` for Pass 2 decoders (0 = ffmpeg default); fewer threads = less decoder RAM.
# FFMPEG_EXTRACTION_THREADS=2
# Pass 2 hardware decode ("none" by default: GPU surface pools cost ~700 MB more per decoder).
# FFMPEG_EXTRACTION_HWACCEL=none
